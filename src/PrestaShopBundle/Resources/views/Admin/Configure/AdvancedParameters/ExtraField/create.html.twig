{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Admin.Advparameters.Feature' %}

{% block content %}
  {% if extraFieldForm.vars.errors is not empty %}
    <div class="alert alert-danger">
      {% for error in extraFieldForm.vars.errors %}
        <div class="alert-text">{{ error.message }}</div>
      {% endfor %}
    </div>
  {% endif %}

  {{ include('@PrestaShop/Admin/Configure/AdvancedParameters/ExtraField/Blocks/form.html.twig', {isEdit: false}) }}
{% endblock %}
