{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Admin.Advparameters.Feature' %}

{% block content %}
  {# ── Read-only summary of structural (non-editable) fields ─────────────── #}
  <div class="card mb-2">
    <h3 class="card-header">
      {{ 'Field definition (read-only)'|trans }}
    </h3>
    <div class="card-body">
      <table class="table">
        <tbody>
          <tr>
            <th>{{ 'Entity'|trans }}</th>
            <td><code>{{ extraFieldInfo.entityName }}</code></td>
          </tr>
          <tr>
            <th>{{ 'Field name'|trans }}</th>
            <td><code>{{ extraFieldInfo.fieldName }}</code></td>
          </tr>
          <tr>
            <th>{{ 'Storage column'|trans }}</th>
            <td><code>{{ extraFieldInfo.storageColumnName }}</code></td>
          </tr>
          <tr>
            <th>{{ 'Type'|trans({}, 'Admin.Global') }}</th>
            <td><span class="badge badge-info">{{ extraFieldInfo.fieldType }}</span></td>
          </tr>
          <tr>
            <th>{{ 'Scope'|trans }}</th>
            <td><span class="badge badge-secondary">{{ extraFieldInfo.fieldScope }}</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  {% if extraFieldForm.vars.errors is not empty %}
    <div class="alert alert-danger">
      {% for error in extraFieldForm.vars.errors %}
        <div class="alert-text">{{ error.message }}</div>
      {% endfor %}
    </div>
  {% endif %}

  {{ include('@PrestaShop/Admin/Configure/AdvancedParameters/ExtraField/Blocks/form.html.twig', {isEdit: true, readOnly: not isCoreField}) }}
{% endblock %}
